{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "what every document window is allowed to do",
  "windows": ["window-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
